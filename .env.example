# Configuration lives in code: every setting has a working default, and the
# service starts, classifies and serves its UI with no .env at all.
#
# The full list, with defaults, is in docs/properties.html (served at
# /ui/properties). Add a line here only to move a setting off its default.

# The one value most deployments supply. Needed only for entity extraction and
# for drafting domain instructions and intents; classification never calls a
# model. Leave it empty to run without those, or set LLM_PROVIDER=mock to run
# them offline with no key at all.
OPENAI_API_KEY=
