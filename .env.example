# ---------------------------------------------------------------------------
# intent-classifier configuration
#
# Every value below has a working default. The ONLY value you need to fill in
# is OPENAI_API_KEY, and only if you turn on entity extraction.
# ---------------------------------------------------------------------------

# --- LLM (entity extraction, disabled by default) --------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ENTITY_EXTRACTION_ENABLED=false

# --- storage ---------------------------------------------------------------
CHROMA_MODE=persistent
CHROMA_PATH=./data/chroma
INDEX_DIR=./data/indexes

# --- embedding model -------------------------------------------------------
MODEL_NAME=BAAI/bge-small-en-v1.5
MODEL_CACHE_DIR=./data/models

# --- retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=10
RRF_K=60
AGG_TOP_N=3

# --- confidence and UNKNOWN handling ---------------------------------------
# Calibrated with: uv run python -m tests.evaluation.run_eval --sweep
# Raising MIN_DENSE_SIMILARITY to 0.70 gives 100% UNKNOWN detection but wrongly
# rejects ~9% of valid queries. Do that if a wrong tool call costs more than a
# refusal.
CONFIDENCE_THRESHOLD=0.55
MIN_DENSE_SIMILARITY=0.60
DENSE_SIM_FLOOR=0.50
DENSE_SIM_CEIL=0.90

# --- misc ------------------------------------------------------------------
LOG_LEVEL=INFO

# --- entity extraction (Phase 3) -------------------------------------------
# Extraction runs only after an intent resolves confidently, never for UNKNOWN.
# It needs OPENAI_API_KEY above. Classification itself never calls an LLM.
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=1

# --- A/B testing of retrieval strategies ------------------------------------
# Variants: hybrid_rrf, dense_only, bm25_only, hybrid_rrf_k20, hybrid_top1,
# hybrid_wide. Assignment is by request id, so it is stable and reproducible.
AB_TESTING_ENABLED=false
DEFAULT_STRATEGY=hybrid_rrf
AB_VARIANTS=hybrid_rrf,dense_only

# --- security ---------------------------------------------------------------
# Off by default so the service runs out of the box. Turn it on and supply keys
# as "secret:domains:scopes", comma separated. "*" means all.
#   API_KEYS=ops-key:*:admin, contract-svc:contract:classify
# Scopes: admin > write > read > classify.
AUTH_ENABLED=false
API_KEYS=

# --- observability ----------------------------------------------------------
METRICS_ENABLED=true
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=./data/audit/audit.jsonl
# User queries can contain personal data, so recording their text is opt-in.
AUDIT_LOG_QUERY_TEXT=false
# Tracing needs a collector; with none running it would retry in the background.
TRACING_ENABLED=false
OTLP_ENDPOINT=http://localhost:4317
